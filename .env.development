# 开发环境：直连后端，需要后端开启 CORS 允许 http://localhost:5173
# electron-vite 的 server.proxy 不生效（见 issue #631），改在后端处理 CORS
RENDERER_VITE_SERVICE_BASE_URL=http://127.0.0.1:8000

# 路由模式：dynamic（后端拉菜单，默认）| static（前端写死，适合 fork 做独立应用）
RENDERER_VITE_ROUTE_MODE=static

# 是否需要登录：true（默认，走完整登录流程）| false（游客模式，跳过登录直接进 home）
RENDERER_VITE_AUTH_REQUIRED=true
